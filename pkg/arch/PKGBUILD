# Maintainer: Raindancer118 <tom560stieh@gmail.com>
pkgname=vela
pkgver=0.35.0
pkgrel=1
pkgdesc="Spotlight-style application launcher for Hyprland with file search and Claude Code integration"
arch=('x86_64' 'aarch64')
url="https://github.com/Raindancer118/vela"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'libadwaita' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('plocate: indexed system-wide file search'
            'kitty: default terminal for Claude Code and terminal apps'
            'xdg-utils: open files with the default application'
            'hyprland: Super-tap integration (vela.lua)'
            'quickshell: control center and notifications (vela shell)'
            'ttf-material-symbols-variable: control center icons'
            'ttf-rubik-vf: control center font'
            'papirus-icon-theme: control center app icons'
            'hyprsunset: night light in the control center'
            'power-profiles-daemon: power mode tile in the control center'
            'hypridle: dimming, locking and suspend while away (vela idle)'
            'brightnessctl: dimming while away'
            'xdg-desktop-portal-hyprland: screen sharing with vela-share-picker'
            'slurp: sharing a screen region')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/vela "$pkgdir/usr/bin/vela"
  install -Dm755 target/release/vela-daemon "$pkgdir/usr/bin/vela-daemon"
  install -Dm755 target/release/vela-share-picker "$pkgdir/usr/bin/vela-share-picker"
  install -Dm755 target/release/vela-pulse "$pkgdir/usr/bin/vela-pulse"
  sed 's|@BINDIR@|/usr/bin|' contrib/systemd/vela.service.in | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/vela.service"
  install -Dm644 contrib/hyprland/vela.lua "$pkgdir/usr/share/vela/hyprland/vela.lua"
  find shell -type f \( -name '*.qml' -o -name '*.js' -o -name '*.svg' \) ! -name 'test-*' -exec install -Dm644 {} "$pkgdir/usr/share/vela/{}" \;
  install -Dm644 data/config.example.toml "$pkgdir/usr/share/vela/config.example.toml"
  install -Dm644 data/vela.desktop "$pkgdir/usr/share/applications/vela.desktop"
  install -Dm644 data/vela-pulse.desktop "$pkgdir/usr/share/applications/vela-pulse.desktop"
  install -Dm644 data/vela-quickshare.desktop "$pkgdir/usr/share/applications/vela-quickshare.desktop"
  install -Dm755 data/vela-quickshare-servicemenu.desktop "$pkgdir/usr/share/kio/servicemenus/vela-quickshare.desktop"
  for icon in data/icons/*.svg; do
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$(basename "$icon")"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
